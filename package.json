{
  "name": "@nodepit/svg-to-img",
  "version": "4.0.0-beta.1",
  "description": "A node.js library to convert SVGs to images built with Puppeteer.",
  "homepage": "https://github.com/NodePit/svg-to-img",
  "keywords": [
    "svg",
    "png",
    "jpg",
    "jpeg",
    "image",
    "puppeteer",
    "node"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Etienne Martin",
    "url": "http://etiennemartin.ca/"
  },
  "contributors": [
    "Philipp Katz (https://gitlab.com/qqilihq)"
  ],
  "scripts": {
    "dev": "tsc --pretty --watch",
    "lint": "eslint --fix ./src",
    "pretest": "pnpm run lint",
    "test": "jest src --coverage --verbose",
    "test:watch": "jest src --coverage --verbose --watch",
    "prebuild": "rm -rf dist/ && pnpm run lint",
    "build": "tsc --pretty",
    "prepare": "pnpm run build && husky",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "postversion": "git push --follow-tags"
  },
  "jest": {
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.js$": [
        "@swc/jest",
        {
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/coverage/",
      "/dist/",
      "/typings/",
      "/tests/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": -10
      }
    },
    "testMatch": [
      "**/?(*.)(test).(tsx|ts)"
    ],
    "collectCoverageFrom": [
      "src/**/*.(tsx|ts)"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(?:puppeteer-core|puppeteer|@puppeteer/browsers)/)"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NodePit/svg-to-img.git"
  },
  "bugs": {
    "url": "https://github.com/NodePit/svg-to-img/issues"
  },
  "engines": {
    "node": ">= 22.12.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "~22.12.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "image-size": "^2.0.4",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^29.7.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.13.0",
    "ts-expect": "^1.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "puppeteer-core": "^25.13.0"
  },
  "peerDependencies": {
    "puppeteer": ">=25.13.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.12.1"
}
