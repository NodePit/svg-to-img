{
  "name": "@nodepit/svg-to-img",
  "version": "4.0.0",
  "description": "A node.js library to convert SVGs to images built with Puppeteer.",
  "homepage": "https://github.com/NodePit/svg-to-img",
  "keywords": [
    "svg",
    "png",
    "jpg",
    "jpeg",
    "image",
    "puppeteer",
    "node"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Etienne Martin",
    "url": "http://etiennemartin.ca/"
  },
  "contributors": [
    "Philipp Katz (https://gitlab.com/qqilihq)"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --pretty --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "pnpm run lint:eslint && pnpm run lint:format && pnpm run lint:types && pnpm run lint:knip",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:types": "tsc --noEmit",
    "lint:knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prebuild": "pnpm run clean",
    "build": "tsc -p tsconfig.build.json --pretty",
    "prepare": "pnpm run build && husky",
    "prepublishOnly": "pnpm run lint && pnpm test",
    "postversion": "git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NodePit/svg-to-img.git"
  },
  "bugs": {
    "url": "https://github.com/NodePit/svg-to-img/issues"
  },
  "engines": {
    "node": ">= 22.12.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~22.12.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "husky": "^9.1.7",
    "image-size": "^2.0.4",
    "jsdom": "~28.1.0",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.13.0",
    "ts-expect": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vitest-canvas-mock": "^1.2.0"
  },
  "dependencies": {
    "puppeteer-core": "^25.13.0"
  },
  "peerDependencies": {
    "puppeteer": ">=25.13.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.12.1"
}
